# amplify
#node_modules
#.amplify
#amplify_outputs*
#amplifyconfiguration*
#############################################################################################################
# Ignore everything by default
*

# Unignore root folders that contain allowed subfolders/files
!.github/
!amplify/
!app/
!components/
!lib/
!scripts/
!seedData/
!public/

# Unignore specific amplify subfolders (so Git traverses them)
!amplify/auth/
!amplify/data/
!amplify/storage/
!amplify/custom-resources/
!amplify/ampfuncs/
!amplify/tasksResolvers

# Unignore contents of allowed amplify subfolders
!amplify/auth/**
!amplify/data/**
!amplify/storage/**
!amplify/custom-resources/**
!amplify/ampfuncs/**
!amplify/tasksResolvers/**

# Unignore .github contents
!.github/**

# Unignore app-specific folders recursively
!app/**
!components/**
!lib/**
!scripts/**
!seedData/**
!public/**

# Unignore specific root files
!amplify/backend.ts
!amplify/package.json
!amplify/tsconfig.json
!components.json
!middleware.ts
!next-env.d.ts
!package.json
!package-lock.json
!postcss.config.js
!tsconfig.json
!next.config.js
!.eslintrc.json
!amplify.yml
!.env.development
!.gitignore
